      "900": { "$value": "#7A1F34", "$type": "color" }
    },
    "gray": {
      "0":   { "$value": "#FFFFFF", "$type": "color" },
      "50":  { "$value": "#EEF7F7", "$type": "color" },
      "100": { "$value": "#E6F0F0", "$type": "color" },
